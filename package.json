{
  "name": "metalmundi",
  "version": "1.0.0",
  "private": true,
  "description": "MetalMundi - full-stack waste material marketplace (PERN: Express + PostgreSQL + Prisma + React)",
  "type": "commonjs",
  "scripts": {
    "install:all": "npm install --no-audit --no-fund && npm --prefix server install --no-audit --no-fund && npm --prefix client install --no-audit --no-fund",
    "dev": "concurrently -n api,web -c green,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test": "npm --prefix server test",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:admin": "node scripts/create-admin.js",
    "seed:categories": "node scripts/seed-categories.js",
    "seed:demo": "node scripts/seed-demo.js",
    "smoke": "node scripts/smoke-test.js",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:deploy": "npm --prefix server run prisma:deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^9.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
