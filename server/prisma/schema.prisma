// MetalMundi — PostgreSQL schema (Prisma).
//
// IDs are 24-char hex strings generated by the application (see
// src/utils/idGenerator.js `newId`) so the existing API contract — which
// exposes ObjectId-shaped identifiers — is preserved.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums (mirror src/utils/constants.js) ───────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum SubmissionStatus {
  PENDING_APPROVAL
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  COLLECTED
  PURCHASED
}

enum QualityGrade {
  A
  B
  C
  D
}

enum MaterialCondition {
  LOOSE
  BALED
  SHREDDED
  MIXED
  USED
}

enum DemandBasis {
  TOTAL
  PER_KG
}

enum LotStatus {
  ACCEPTED
  PUBLISHED
  DEPLETED
  ARCHIVED
}

enum ListingStatus {
  DRAFT
  PUBLISHED
  PAUSED
  SOLD_OUT
}

enum OrderStatus {
  PENDING_ADMIN_APPROVAL
  ACCEPTED
  INSPECTION_SCHEDULED
  INSPECTION_IN_PROGRESS
  DELIVERY_CHARGE_PENDING
  AWAITING_BUYER_CONFIRMATION
  REJECTED
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum InspectionStatus {
  PENDING
  SCHEDULED
  IN_PROGRESS
  PASSED
  FAILED
}

enum DeliveryChargeStatus {
  NOT_SET
  AWAITING_BUYER_CONFIRMATION
  CONFIRMED
  REJECTED
}

enum MovementType {
  IN
  RESERVE
  RELEASE
  COMMIT
  ADJUST
}

enum NotificationType {
  SUBMISSION
  ORDER
  ACCOUNT
  SYSTEM
  AUCTION
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum SaleMode {
  NORMAL
  AUCTION
}

enum AuctionStatus {
  PENDING_APPROVAL
  SCHEDULED
  ACTIVE
  ENDED
  AWAITING_PAYMENT
  AWAITING_PICKUP
  COMPLETED
  CANCELLED
  NO_BIDS
}

enum BidStatus {
  LEADING
  OUTBID
  WON
  LOST
}

enum BidIncrementType {
  FIXED
  PERCENT
}

// ── Models ──────────────────────────────────────────────────────────────────

model User {
  id            String        @id
  name          String
  email         String        @unique
  phone         String
  passwordHash  String
  role          Role          @default(USER)
  address       Json          @default("{}")
  accountStatus AccountStatus @default(ACTIVE)

  emailVerificationVerified  Boolean   @default(false)
  emailVerificationToken     String?
  emailVerificationExpiresAt DateTime?

  passwordResetToken     String?
  passwordResetExpiresAt DateTime?

  lastLoginAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissionsSold       WasteSubmission[] @relation("submissionSeller")
  submissionsReviewed   WasteSubmission[] @relation("submissionReviewer")
  submissionsApproved   WasteSubmission[] @relation("submissionApprover")
  submissionsCollected  WasteSubmission[] @relation("submissionCollector")
  submissionsPricedBy   WasteSubmission[] @relation("submissionPriceSetter")
  lotsSold              InventoryLot[]    @relation("lotSeller")
  listingsPublished     MarketplaceListing[] @relation("listingPublisher")
  orders                Order[]           @relation("orderBuyer")
  ordersSold            Order[]           @relation("orderSeller")
  deliveryChargesSet    Order[]           @relation("orderDeliveryChargeSetter")
  addressesReleased     Order[]           @relation("orderAddressReleaser")
  inspectionsPerformed  Inspection[]      @relation("inspectionInspector")
  notifications         Notification[]
  auditLogs             AuditLog[]        @relation("auditActor")
  inventoryMovements    InventoryMovement[] @relation("movementActor")
  pricingConfigurations PricingConfiguration[] @relation("pricingUpdatedBy")

  auctionsSold          WasteAuction[]    @relation("auctionSeller")
  auctionsWon           WasteAuction[]    @relation("auctionWinner")
  auctionsApproved      WasteAuction[]    @relation("auctionApprover")
  auctionsRejected      WasteAuction[]    @relation("auctionRejecter")
  auctionsCancelled     WasteAuction[]    @relation("auctionCanceller")
  auctionBids           WasteAuctionBid[] @relation("auctionBidder")
  auctionSettingsUpdated AuctionSettings[] @relation("auctionSettingsUpdater")

  @@index([role, accountStatus])
  @@map("users")
}

model MaterialCategory {
  id          String  @id
  name        String  @unique
  slug        String  @unique
  description String  @default("")
  icon        String  @default("recycle")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pricingConfigurations PricingConfiguration[]
  submissions           WasteSubmission[]
  lots                  InventoryLot[]
  listings              MarketplaceListing[]
  auctions              WasteAuction[]

  @@index([active])
  @@map("material_categories")
}

model PricingConfiguration {
  id                 String @id
  materialCategoryId String
  materialType       String @default("")

  ratePerKgPaise      Int
  qualityMultipliers  Json   @default("{}")
  basePickupChargePaise Int  @default(50000)
  perKmChargePaise    Int    @default(1200)
  platformFeePercent  Float  @default(5)
  taxPercent          Float  @default(18)

  version Int     @default(1)
  active  Boolean @default(true)
  notes   String  @default("")

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialCategory MaterialCategory @relation(fields: [materialCategoryId], references: [id])
  updatedBy        User?            @relation("pricingUpdatedBy", fields: [updatedById], references: [id])

  @@index([materialCategoryId, materialType, active, version])
  @@map("pricing_configurations")
}

model WasteSubmission {
  id               String @id
  submissionNumber String @unique

  sellerId           String
  materialCategoryId String
  materialType       String
  quantityKg         Float
  condition          MaterialCondition
  qualityGrade       QualityGrade
  description        String

  images  Json
  pickup  Json

  demandBasis         DemandBasis
  demandedTotalPaise  Int @default(0)
  demandedPerKgPaise  Int @default(0)

  valuation Json @default("{}")

  proposedPurchasePricePaise    Int       @default(0)
  proposedPurchasePriceSetById  String?
  proposedPurchasePriceSetAt    DateTime?

  acceptedQuantityKg Float @default(0)

  status          SubmissionStatus @default(PENDING_APPROVAL)
  rejectionReason String           @default("")

  saleMode SaleMode @default(NORMAL)

  adminNotes Json @default("[]")

  reviewedById  String?
  reviewedAt    DateTime?
  approvedById  String?
  approvedAt    DateTime?
  collectedById String?
  collectedAt   DateTime?
  pickupDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seller                 User                @relation("submissionSeller", fields: [sellerId], references: [id])
  materialCategory       MaterialCategory    @relation(fields: [materialCategoryId], references: [id])
  proposedPurchasePriceSetBy User?           @relation("submissionPriceSetter", fields: [proposedPurchasePriceSetById], references: [id])
  reviewedBy             User?               @relation("submissionReviewer", fields: [reviewedById], references: [id])
  approvedBy             User?               @relation("submissionApprover", fields: [approvedById], references: [id])
  collectedBy            User?               @relation("submissionCollector", fields: [collectedById], references: [id])
  inventoryLot           InventoryLot?
  listing                MarketplaceListing?
  auction                WasteAuction?

  @@index([status, createdAt])
  @@index([sellerId, createdAt])
  @@index([materialCategoryId, materialType])
  @@index([saleMode, status])
  @@map("waste_submissions")
}

model InventoryLot {
  id                 String @id
  lotNumber          String @unique
  sourceSubmissionId String? @unique
  sellerId           String
  materialCategoryId String

  materialType String
  qualityGrade QualityGrade
  condition    MaterialCondition

  acceptedQuantityKg Float
  availableQuantityKg Float
  reservedQuantityKg  Float @default(0)
  soldQuantityKg      Float @default(0)

  location Json @default("{}")
  city     String @default("")
  state    String @default("")
  latitude  Float?
  longitude Float?

  lotStatus  LotStatus @default(ACCEPTED)
  receivedAt DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourceSubmission WasteSubmission? @relation(fields: [sourceSubmissionId], references: [id])
  seller           User            @relation("lotSeller", fields: [sellerId], references: [id])
  materialCategory MaterialCategory @relation(fields: [materialCategoryId], references: [id])

  listing   MarketplaceListing?
  movements InventoryMovement[]

  @@index([materialCategoryId, materialType, lotStatus])
  @@index([availableQuantityKg])
  @@index([city, state])
  @@index([latitude, longitude])
  @@map("inventory_lots")
}

model MarketplaceListing {
  id                 String @id
  title              String
  materialCategoryId String
  materialType       String
  description        String

  images Json @default("[]")

  inventoryLotId     String @unique
  sourceSubmissionId String? @unique

  qualityGrade QualityGrade
  condition    MaterialCondition

  pricePerKgPaise Int
  minPurchaseKg   Float @default(0)

  acceptedQuantityKg  Float @default(0)
  availableQuantityKg Float @default(0)
  reservedQuantityKg  Float @default(0)
  soldQuantityKg      Float @default(0)

  location      Json   @default("{}")
  city           String @default("")
  state          String @default("")
  latitude       Float?
  longitude      Float?
  deliveryTerms  String @default("Pickup from MetalMundi facility")

  publicationStatus ListingStatus @default(DRAFT)
  active            Boolean       @default(false)

  // AI-image screening result (warn-only; never blocks the listing).
  imageCheckStatus   String    @default("pending")
  imageCheckFlagged  Boolean   @default(false)
  imageCheckMaxScore Float?
  imageCheckPerImage Json      @default("[]")
  imageCheckError    String?
  imageCheckedAt     DateTime?

  publishedById String?
  publishedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialCategory MaterialCategory  @relation(fields: [materialCategoryId], references: [id])
  inventoryLot     InventoryLot      @relation(fields: [inventoryLotId], references: [id])
  sourceSubmission WasteSubmission?  @relation(fields: [sourceSubmissionId], references: [id])
  publishedBy      User?             @relation("listingPublisher", fields: [publishedById], references: [id])

  @@index([active, publicationStatus, availableQuantityKg])
  @@index([materialCategoryId, active, publicationStatus])
  @@index([imageCheckFlagged])
  @@index([pricePerKgPaise])
  @@index([createdAt])
  @@index([city, state])
  @@index([latitude, longitude])
  @@map("marketplace_listings")
}

model Order {
  id          String @id
  orderNumber String @unique

  buyerId         String
  sellerId        String?
  idempotencyKey  String? @unique

  delivery Json
  items    Json @default("[]")

  materialSubtotalPaise Int
  taxPercent            Float @default(0)
  taxPaise              Int   @default(0)
  transportationPaise   Int   @default(0)
  otherFeesPaise        Int   @default(0)
  totalPaise            Int

  quoteIsProvisional Boolean
  // Incremented whenever the recorded quantity or delivery charge changes the
  // order total after the buyer last saw it, so the UI can flag revised terms.
  termsRevision Int @default(0)

  status        OrderStatus @default(PENDING_ADMIN_APPROVAL)
  statusHistory Json        @default("[]")

  notes           String @default("")
  rejectionReason String @default("")
  adminNotes      String @default("")

  inventoryReserved Boolean @default(false)
  inventoryCommitted Boolean @default(false)

  paymentStatus    PaymentStatus @default(UNPAID)
  paymentProvider  String        @default("")
  paymentReference String        @default("")
  paymentPaidAt    DateTime?

  // Inspection/delivery-charge workflow
  inspectionStatus     InspectionStatus     @default(PENDING)
  deliveryChargePaise  Int                 @default(0)
  deliveryChargeStatus DeliveryChargeStatus @default(NOT_SET)
  deliveryChargeSetById String?
  deliveryChargeSetAt  DateTime?
  deliveryChargeNotes  String             @default("")
  buyerConfirmedAt     DateTime?
  buyerConfirmationNote String             @default("")
  addressReleased      Boolean             @default(false)
  addressReleasedAt    DateTime?
  addressReleasedById  String?
  addressReleaseReason String             @default("")

  // Set only for orders created by winning an auction �?" their items carry no
  // marketplace listing, so lot-reservation side effects are skipped for them.
  auctionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  buyer                User        @relation("orderBuyer", fields: [buyerId], references: [id])
  seller               User?       @relation("orderSeller", fields: [sellerId], references: [id])
  deliveryChargeSetBy  User?       @relation("orderDeliveryChargeSetter", fields: [deliveryChargeSetById], references: [id])
  addressReleasedBy    User?       @relation("orderAddressReleaser", fields: [addressReleasedById], references: [id])
  auction              WasteAuction? @relation(fields: [auctionId], references: [id])

  inventoryMovements InventoryMovement[]
  inspection         Inspection?

  @@index([buyerId, createdAt])
  @@index([sellerId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model Inspection {
  id      String @id
  orderId String @unique

  inspectorId String?
  status      InspectionStatus @default(PENDING)

  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?

  notes        String @default("")
  failureReason String @default("")
  photos       Json   @default("[]")

  // Recorded when the inspection passes. `actualQuantityKg` differs from the
  // booked quantity when the weighed-out material is short or surplus; the
  // buyer must re-confirm the order when that changes the material subtotal.
  actualQuantityKg    Float             @default(0)
  materialCondition   MaterialCondition @default(LOOSE)
  quantityChangedFromKg Float           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  inspector User? @relation("inspectionInspector", fields: [inspectorId], references: [id])

  @@index([status, scheduledAt])
  @@map("inspections")
}

model Notification {
  id      String           @id
  userId  String
  title   String
  message String
  type    NotificationType @default(SYSTEM)

  relatedType String @default("")
  relatedId   String?

  read Boolean @default(false)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model AuditLog {
  id      String  @id
  actorId String?
  actorRole String @default("")

  action       String
  resourceType String
  resourceId   String?

  before Json?
  after  Json?
  meta   Json?

  ip        String @default("")
  userAgent String @default("")

  createdAt DateTime @default(now())

  actor User? @relation("auditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([resourceType, resourceId, createdAt])
  @@map("audit_logs")
}

model InventoryMovement {
  id String @id

  lotId String
  type  MovementType

  quantityKg        Float
  balanceAvailableKg Float @default(0)
  balanceReservedKg  Float @default(0)
  balanceSoldKg      Float @default(0)

  reason  String  @default("")
  orderId String?
  actorId String?

  createdAt DateTime @default(now())

  lot   InventoryLot @relation(fields: [lotId], references: [id])
  order Order?       @relation(fields: [orderId], references: [id])
  actor User?        @relation("movementActor", fields: [actorId], references: [id])

  @@index([lotId, createdAt])
  @@map("inventory_movements")
}

// ── Auctions ────────────────────────────────────────────────────────────────
//
// A WasteAuction is created together with an AUCTION-mode WasteSubmission. The
// auction is the source of truth for the timer, the highest bid and the winner;
// the linked submission tracks the underlying material record. All money is
// integer paise; all timestamps are server-side.

model WasteAuction {
  id            String @id
  auctionNumber String @unique

  submissionId       String @unique
  sellerId           String
  materialCategoryId String

  materialType    String
  quantityKg      Float
  condition       MaterialCondition
  qualityGrade    QualityGrade
  images          Json   @default("{}")
  location        Json   @default("{}")
  inspectionNotes String @default("")

  // Four separate seller/admin price signals — never collapsed into one value.
  startingPricePerKgPaise    Int
  expectedPricePerKgPaise    Int  @default(0)
  minAcceptableBidPerKgPaise Int  @default(0)
  // Optional reserve. Only the seller and admins can see this value.
  reservePricePerKgPaise     Int?

  // Bid-rule snapshot (copied from AuctionSettings when the auction is created).
  minIncrementType            BidIncrementType @default(FIXED)
  minIncrementValue           Float           @default(100)
  antiSnipingEnabled          Boolean         @default(false)
  antiSnipingWindowSeconds    Int             @default(30)
  antiSnipingExtensionSeconds Int             @default(60)

  durationMinutes Int
  status          AuctionStatus @default(PENDING_APPROVAL)

  startAt        DateTime?
  endAt          DateTime?
  extensionCount Int       @default(0)

  currentHighestBidPerKgPaise Int?
  currentHighestBidId         String?
  currentHighestBidderId      String?
  bidCount                    Int     @default(0)
  bidderCount                 Int     @default(0)

  winnerId              String?
  winningBidId          String?
  winningBidPerKgPaise  Int?
  winningTotalPaise     Int?
  winnerSelectionReason String @default("")
  settlement            Json   @default("{}")
  adjustments           Json   @default("[]")

  rejectionReason    String @default("")
  cancellationReason String @default("")

  approvedById  String?
  approvedAt    DateTime?
  rejectedById  String?
  rejectedAt    DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  finalizedAt   DateTime?
  completedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission       WasteSubmission  @relation(fields: [submissionId], references: [id])
  seller           User             @relation("auctionSeller", fields: [sellerId], references: [id])
  materialCategory MaterialCategory @relation(fields: [materialCategoryId], references: [id])
  approvedBy       User?            @relation("auctionApprover", fields: [approvedById], references: [id])
  rejectedBy       User?            @relation("auctionRejecter", fields: [rejectedById], references: [id])
  cancelledBy      User?            @relation("auctionCanceller", fields: [cancelledById], references: [id])
  winner           User?            @relation("auctionWinner", fields: [winnerId], references: [id])

  order Order?
  bids  WasteAuctionBid[]

  @@index([status, endAt])
  @@index([status, startAt])
  @@index([sellerId, createdAt])
  @@index([materialCategoryId, materialType, status])
  @@map("waste_auctions")
}

model WasteAuctionBid {
  id        String @id
  auctionId String
  bidderId  String

  bidPerKgPaise      Int
  totalBidValuePaise Int

  status BidStatus @default(LEADING)

  // Optional client-supplied key: replays of the same request never create a
  // second bid row.
  idempotencyKey String?

  createdAt DateTime @default(now())

  auction WasteAuction @relation(fields: [auctionId], references: [id])
  bidder  User         @relation("auctionBidder", fields: [bidderId], references: [id])

  @@unique([auctionId, idempotencyKey])
  @@index([auctionId, createdAt])
  @@index([bidderId, createdAt])
  @@map("waste_auction_bids")
}

model AuctionSettings {
  id String @id

  minAuctionQuantityKg Float @default(500)

  sellerCanChooseDuration Boolean @default(true)
  defaultDurationMinutes  Int     @default(30)
  minDurationMinutes      Int     @default(10)
  maxDurationMinutes      Int     @default(1440)
  allowedDurationsMinutes Json    @default("[10,15,30,60]")

  minIncrementType  BidIncrementType @default(FIXED)
  minIncrementValue Float            @default(100)

  antiSnipingEnabled          Boolean @default(false)
  antiSnipingWindowSeconds    Int     @default(30)
  antiSnipingExtensionSeconds Int     @default(60)

  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation("auctionSettingsUpdater", fields: [updatedById], references: [id])

  @@map("auction_settings")
}
