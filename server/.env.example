# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Local Docker PostgreSQL (docker-compose.yml default).
DATABASE_URL=postgresql://admin:adminpassword@localhost:5432/metalmundi
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=change-me-to-a-long-random-string

# ── CORS / public URL ───────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
API_PUBLIC_URL=http://localhost:5000

# ── Admin seed (dev only) ───────────────────────────────────────────────────
ADMIN_NAME=MetalMundi Admin
ADMIN_EMAIL=admin@metalmundi.test
ADMIN_PASSWORD=ChangeMe123!

# ── Image storage (optional — falls back to local server/uploads/) ──────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=metalmundi

# ── AI-image detection (optional) ───────────────────────────────────────────
# URL of the ai-detect-service (FastAPI) deployment, e.g. a Hugging Face Space.
# Leave unset to skip AI image checks entirely.
ML_SERVICE_URL=
# Score (0-1) at or above which a listing is flagged for admin review.
AI_FLAG_THRESHOLD=0.8
