# PostgreSQL Docker setup for MetalMundi
# Copy to .env and fill values. Do NOT commit real credentials.
POSTGRES_DB=metalmundi
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_PORT=5432

# Backend connection string (server/.env). Must match the POSTGRES_* values above.
# DATABASE_URL=postgresql://admin:your_postgres_password_here@localhost:5432/metalmundi
